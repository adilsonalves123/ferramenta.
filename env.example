# Copie este arquivo para .env na mesma pasta. Nada disso entra no código.
# Cole aqui a connection string do Postgres (a mesma do outro app, no painel do Supabase: Connect).
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres

OPENAI_API_KEY=sk-troque-aqui
OPENAI_MODEL=gpt-4o-mini

# Origens que podem chamar a API. Separe por vírgula.
CORS_ORIGINS=http://localhost:3000,https://www.riscaai.com.br

# Só entram quando for ligar Instagram e Facebook. Sem isso, a agenda guarda o horário e não publica.
